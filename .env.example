# ─────────────────────────────────────────────────────────────────────────────
# «Слушаем вместе» — переменные окружения. Скопируйте в `.env` и заполните.
# Файл `.env` в git не попадает. Никогда не коммитьте реальные значения.
# ─────────────────────────────────────────────────────────────────────────────

# Окружение: dev | test | prod. В prod включаются Secure-cookie и строгие проверки.
ENV=dev
# Уровень логов: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# JSON-логи (в проде true, локально удобнее false)
LOG_JSON=false

# Домен сервиса (используется Caddy для HTTPS в production-compose)
DOMAIN=music.example.com
# Публичный origin фронтенда. По нему проверяются Origin у WebSocket и изменяющих REST-запросов.
PUBLIC_ORIGIN=http://localhost:5173

# PostgreSQL (SQLAlchemy async URL)
DATABASE_URL=postgresql+asyncpg://music:music@localhost:5432/music
# Пароль Postgres для production-compose
POSTGRES_PASSWORD=change-me

# Секрет для подписи сессий. Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me
# Ключи шифрования токенов Яндекса (Fernet), через запятую. Первый — текущий, остальные — для расшифровки
# старых (ротация). Сгенерировать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEYS=

# Музыкальный провайдер: yandex | fake (fake — локальные тестовые треки, без аккаунта Яндекса)
MUSIC_PROVIDER=fake
# Режим получения аудио: direct (браузер играет прямую ссылку) | proxy (бэкенд стримит поток с Range)
AUDIO_MODE=direct
# Необязательный HTTP/SOCKS-прокси для запросов к Яндексу (например, если сервер вне РФ):
# YM_PROXY_URL=socks5://user:pass@host:1080
YM_PROXY_URL=

# Sentry (необязательно; пусто — выключено)
SENTRY_DSN=

# ── Только для scripts/spike_yandex.py (локально, НЕ для сервера) ──────────────
# OAuth-токен Яндекс Музыки владельца для спайка. Можно получить командой
#   cd backend && uv run python ../scripts/spike_yandex.py auth
# YM_TOKEN=
