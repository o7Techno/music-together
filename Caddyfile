# Caddy: статика фронта, reverse proxy на бэкенд, автоматический HTTPS (Let's Encrypt),
# заголовки безопасности (SPEC §7.6). Домен и почта — из переменных окружения.
{
	email {$ACME_EMAIL:admin@example.com}
}

{$DOMAIN:localhost} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		# Обложки и аватары — avatars.yandex.net; аудио в режиме direct — *.yandex.net / *.yandex.ru.
		# style-src 'unsafe-inline' нужен для style-атрибутов React (градиенты, ширина прогресса).
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://avatars.yandex.net; media-src 'self' blob: https://*.yandex.net https://*.yandex.ru; connect-src 'self' wss://{$DOMAIN:localhost} https://*.ingest.sentry.io https://*.ingest.de.sentry.io; font-src 'self'; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		-Server
	}

	@backend path /api/* /ws/* /health /ready /media/*
	handle @backend {
		reverse_proxy backend:8000 {
			# Долгие WebSocket-соединения и прокси-стримы аудио.
			flush_interval -1
		}
	}

	handle {
		root * /srv
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@html path / /index.html /r/*
		header @html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format json
	}
}
